# Obtenha estas chaves em: https://supabase.com -> Seu Projeto -> Project Settings -> API

# URL da sua instância Supabase (Ex: https://xyzcompany.supabase.co)
VITE_SUPABASE_URL=https://sua-url-aqui.supabase.co

# Chave anônima pública (anon / public key) — NUNCA use a service_role key aqui!
VITE_SUPABASE_ANON_KEY=sua-chave-anon-publica-aqui
